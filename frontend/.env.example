VITE_API_URL=/api
# Copy this file to .env.local and restart Vite after changing values.
# Google Auth Platform -> Clients -> Create client -> Web application.
# Set the same real public Web Client ID as backend GOOGLE_CLIENT_ID.
# Add http://localhost and http://localhost:5173 to Authorized JavaScript origins.
# Leave blank until configured: the UI shows a notice and email/password login still works.
# Never put a Google Client Secret in VITE_* variables. See README.md: Login and Google setup.
VITE_GOOGLE_CLIENT_ID=
