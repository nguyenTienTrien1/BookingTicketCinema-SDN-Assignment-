PORT=3000
# From the repository root: npm run setup:local
# Starts a local replica set, safely imports existing local data, and prepares .env.
MONGODB_URI=mongodb://127.0.0.1:27019/booking_cinema?replicaSet=cinemaLocal
# Optional when mongod is outside PATH and the normal MongoDB Server folder:
MONGOD_BINARY=

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
# Google Auth Platform -> Clients -> Create client -> Web application.
# Copy the real public Web Client ID here and into frontend VITE_GOOGLE_CLIENT_ID.
# Authorized JavaScript origins for local development: http://localhost and http://localhost:5173.
# Leave blank until configured: Google endpoints return 503; email/password login still works.
# No Google Client Secret is needed. See README.md: Login and Google setup.
GOOGLE_CLIENT_ID=

CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=your_cookie_secret_here
CLIENT_URL=http://localhost:5173
# UC-19 technical default, independent of BR-8 registration links.
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_FROM="CINEMA+ Rạp Phim" <noreply@cinema.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Optional Gmail aliases supported by the existing email service:
GMAIL_USER=
GMAIL_APP_PASS=




# Simulation is rejected when NODE_ENV=production.
ENABLE_PAYMENT_SIMULATION=true
POINT_REDEEM_STEP=1
# VNPay Sandbox checkout requires merchant credentials and a public IPN URL.
# Register https://<public-backend>/api/payments/vnpay/ipn with VNPay.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Development Sandbox only: verify signed Return URL when IPN is unavailable.
# This fallback is always disabled in production and for non-Sandbox gateways.
VNPAY_SANDBOX_RETURN_FALLBACK=true
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
