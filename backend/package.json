    "test:counter-promotions": "node --test test_counter_promotions.js",
    "test:counter-promotions:ui": "node scripts/test-counter-promotions-ui.js",
    "test:online-promotions": "node --test test_online_promotions.js",
    "test:online-promotions:ui": "node scripts/test-online-promotions-ui.js",
