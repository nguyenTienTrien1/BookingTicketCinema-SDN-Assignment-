    "test:food-sales": "node --test test_food_sales.js",
    "test:catalogue": "node --test test_catalogue.js",
    "test:profile": "node --test test_profile.js",
    "test:password-reset": "node --test test_password_reset.js",
    "test:google-auth": "node --test test_google_auth.js",
